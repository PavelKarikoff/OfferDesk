OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Текстовая LLM: gigachat (без VPN) или openai.
# Пустое значение: gigachat, если задан GIGACHAT_CREDENTIALS, иначе openai.
# Картинки (OPENAI_IMAGE_MODEL) остаются на OpenAI.
LLM_PROVIDER=gigachat
# Authorization Key из личного кабинета GigaChat. В git не коммитить.
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлицо; для компании GIGACHAT_API_B2B или GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Пустое значение = GigaChat-2
GIGACHAT_MODEL=
# Пусто или false — не проверять сертификат Минцифры (как в локальном интенсиве).
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_CA_BUNDLE_FILE=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# Ключ из кабинета proxyapi.ru. В git не коммитить.
# Если заполнен, OpenAI идёт на OPENAI_BASE_URL без VPN.
PROXYAPI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Username бота без @ (опционально; иначе берётся через getMe)
# TELEGRAM_BOT_USERNAME=DomMasterKPBot
# Список Telegram user id через запятую (пусто = без ограничения, не рекомендуется)
TELEGRAM_ALLOWED_IDS=
# Токен для Flask API (заголовок X-API-Token или Authorization: Bearer …)
# Без токена API доступен только с localhost
FLASK_API_TOKEN=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# OpenAI через прокси (VPS РФ часто режет api.openai.com)
# OPENAI_PROXY=http://user:pass@host:8080
# или SOCKS: OPENAI_PROXY=socks5://127.0.0.1:1080
# Альтернативы: HTTPS_PROXY / HTTP_PROXY / ALL_PROXY
# OPENAI_PROXY=
# Порог заполнения эталона (%) для генерации КП в CRM (web_app)
ETALON_KP_THRESHOLD=80
# Порт на хосте для docker compose (macOS: 5000 часто занят AirPlay)
API_HOST_PORT=5001
GO_API_HOST_PORT=5002
# В Docker задайте FLASK_API_TOKEN (без него снаружи контейнера будет 401)

# CRM: зависшие сделки (дней без действий) и cooldown повторных напоминаний
# CRM_STALE_DAYS=3
# CRM_REMINDER_COOLDOWN_HOURS=24
# CRM_PUBLIC_URL=http://194.67.103.144:5001
# Логины администраторов сервиса (через запятую). Всегда действует также username=admin.
# Только они могут удалять сделки, очищать список и загружать демо.
# CRM_ADMIN_USERS=admin

# Health-мониторинг (scripts/health_check.sh + systemd timer)
# Алерты только в явный ops-чат. Не ставить id менеджера ОП — иначе спам в рабочий бот.
# HEALTH_ALERT_CHAT_ID=
# HEALTH_ALERT_COOLDOWN_MIN=30

# BlueTerbium SSH (локально в .env; пароль не коммитить)
# BLUETERBIUM_SSH_HOST=194.67.103.144
# BLUETERBIUM_SSH_PORT=2222
# BLUETERBIUM_SSH_USER=root
# BLUETERBIUM_SSH_PASSWORD=

# Входящий вебхук Битрикс24 с правами CRM, задач и уведомлений.
# Полный адрес вида https://портал.bitrix24.ru/rest/1/код/
# Если адрес задан, создание сделки и сборка КП сами уходят в Bitrix24
# (заявка, транскрибация, файл КП). Пусто — выгрузка выключена, CRM работает как раньше.
# Годится и BITRIX_URL= с тем же адресом.
# B24_URL=

# SMTP для отправки КП клиенту из CRM (Yandex / Mail.ru / Gmail)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_USER=your@yandex.ru
# SMTP_PASSWORD=app_password
# SMTP_FROM=your@yandex.ru
# SMTP_USE_TLS=1

# Docker Hub (опционально, для pull без локальной сборки)
# DOCKERHUB_USER=yourname
# DOCKERHUB_IMAGE_API=yourname/ai-auogeneration:latest
# DOCKERHUB_IMAGE_GO=yourname/ai-auogeneration-go:latest
